# Optional: the standalone HTTP server (`syscon-tts serve`).
#
# The APU does NOT need this. It imports syscon_tts in-process (see DEPLOY.md
# section 2), so this unit is only for hosts that want the HTTP API for local
# tools or smoke tests. /synthesize returns audio in the response body and
# never writes to the alerts directory, so the service needs no write access
# anywhere.
#
# EDIT ME before installing: every path and the account below are
# placeholders. Point ExecStart at the Python environment syscon-tts is
# installed into on this host, and pick an unprivileged account that can read
# the voices directory.

[Unit]
Description=Syscon TTS HTTP server (offline text-to-speech)
After=network.target

[Service]
Type=simple
# EDIT ME: an unprivileged account that can read SYSCON_TTS_VOICES_DIR.
User=syscon-tts
Group=syscon-tts

# Voice models are read from here. They live outside the APU tree: they are
# large, immutable and re-downloadable, and anything under MEDIA_ROOT is
# copied into every APU backup.
Environment=SYSCON_TTS_VOICES_DIR=/var/lib/syscon-tts/voices
Environment=SYSCON_TTS_HOST=127.0.0.1
Environment=SYSCON_TTS_PORT=5002
Environment=SYSCON_TTS_DEFAULT_VOICE=en_us_kristin
# Leave CPU for the rest of the host; see DEPLOY.md, "Tuning for the APU CPU".
#Environment=SYSCON_TTS_THREADS=2

# EDIT ME: the syscon-tts entry point of the environment it was installed into.
ExecStart=/opt/syscon-tts/.venv/bin/syscon-tts serve
Restart=on-failure
RestartSec=3

# Hardening: the server only reads models and answers on loopback.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
